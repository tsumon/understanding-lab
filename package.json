{
  "name": "understanding-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "build:offline": "npm run build && node tools/build-sw.ts",
    "preview:offline": "vite preview --host 127.0.0.1 --port 4173",
    "test:e2e": "npm run build:offline && playwright test",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "experiment:test": "uv run --project tools/experiment --locked pytest tools/experiment/test_generate.py",
    "experiment:generate": "uv run --project tools/experiment --locked python tools/experiment/generate.py"
  },
  "dependencies": {
    "openai": "7.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "27.4.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
