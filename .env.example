# 本机服务使用此明确 Origin；公开部署必须改为 HTTPS。
PUBLIC_ORIGIN=http://localhost:3001
PORT=3001
DB_PATH=./data/understanding.sqlite
# 凭据由部署者填写，绝不使用 VITE_ 前缀。
BETTER_AUTH_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 仅明确 true + 完整配置才会在每次启动探测一次，可能计费。
TUTOR_ENABLED=false
TUTOR_MODEL=
TRANSCRIBE_ENABLED=false
TRANSCRIBE_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
